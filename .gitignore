# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 수집 원본 — 커밋하지 않는다 (타사 저작물, 85MB). 방법은 docs/DATA_COLLECTION.md
/data/raw/

# 파이썬
__pycache__/
*.pyc
/data/ml/
/data/v2/sources.csv
/data/v2/observations.csv
